# pyweb production-like nginx config.
#
# Run via ./nginx/start.sh; it substitutes __PYWEB_ROOT__ with the absolute
# repo path and starts nginx with -c (so this file is read in isolation,
# without merging into any system nginx) and -p /tmp/pyweb-nginx (so log,
# pid, and temp paths land in a writable, non-privileged location).

worker_processes  1;
pid               pyweb-nginx.pid;
error_log         pyweb-nginx-error.log warn;

events {
    worker_connections  256;
}

http {
    # System mime.types ships with the nginx package; absolute path keeps
    # this config self-contained when -p points at /tmp.
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log    pyweb-nginx-access.log;
    sendfile      on;
    keepalive_timeout 65;

    # Photo cap is 5 MB and PDF cap is 10 MB on the backend; allow some
    # multipart overhead.
    client_max_body_size 12m;

    # gzip text-y responses. Image / PDF blobs are already compressed and
    # are intentionally absent from gzip_types. text/html is compressed by
    # default and does not need to be listed.
    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_comp_level   6;
    gzip_proxied      any;
    gzip_types
        text/css
        text/plain
        text/xml
        application/javascript
        application/json
        application/xml
        application/wasm
        image/svg+xml
        font/ttf
        font/otf;

    server {
        listen      8080;
        server_name localhost 127.0.0.1;

        root  __PYWEB_ROOT__/frontend/dist;
        index index.html;

        # Vite emits hashed filenames for everything under /assets/ — when
        # the bundle changes, the filename changes too, so the cache key
        # turns over on its own. Tell the browser to cache forever and
        # skip even conditional revalidation; this turns repeat visits
        # into pure disk-cache hits. Using only add_header (not the
        # `expires` directive) so we don't emit two Cache-Control values.
        location ^~ /assets/ {
            add_header Cache-Control "public, immutable, max-age=31536000";
            try_files $uri =404;
        }

        # index.html is the SPA entry point and its filename is NOT hashed,
        # so we MUST NOT cache it — otherwise users keep referencing old
        # hashed bundle filenames after a deploy and end up with a white
        # screen until they manually clear cache. The same header also
        # needs to apply when index.html is served via try_files for SPA
        # routes (/, /members, /login, etc.), which is why the rule lives
        # in the catch-all location too.
        location = /index.html {
            add_header Cache-Control "no-cache";
        }

        # SPA history-mode fallback: any unknown path returns index.html so
        # that vue-router can take over after the page loads. Real assets
        # under /assets/ are served directly because $uri matches them.
        location / {
            # Same no-cache header as the dedicated /index.html block —
            # nginx's add_header only inherits when the child has none of
            # its own, so we duplicate it here so SPA routes that fall
            # through try_files into index.html still tell the browser
            # not to cache the entry document.
            add_header Cache-Control "no-cache";
            try_files $uri $uri/ /index.html;
        }

        # Reverse proxy to the FastAPI backend on the same host. Cookies
        # round-trip transparently because the browser sees same-origin
        # requests on :8080.
        location /api/ {
            proxy_pass         http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
