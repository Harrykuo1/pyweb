# Copy this to .env at the repo root and fill in real values before
# running `docker compose up`. docker-compose's env_file feature reads
# this file directly into the backend container's environment.

# Session signing secret (required). Use a long random string.
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_MAX_AGE_SECONDS=86400

# Comma-separated allowed origins for CORS. With docker-compose the
# browser only ever sees same-origin :8080 requests so this is unused
# at runtime; keep a sane default for safety.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Seed accounts written by app/init_db.py on every container start.
# init_db is idempotent — once a username exists its password is left
# alone, so changing these after first boot has no effect.
SEED_ADMIN_USERNAME=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_VIEWER_USERNAME=CHANGE_ME
SEED_VIEWER_PASSWORD=CHANGE_ME
