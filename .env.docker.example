# Copy this to .env at the repo root and fill in real values before
# running `docker compose up`. docker-compose's env_file feature reads
# this file directly into the backend container's environment.

# Session signing secret (required). Use a long random string.
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_MAX_AGE_SECONDS=86400
# Set true when the site is served over HTTPS so the session cookie
# carries the Secure flag. Keep false for plain-HTTP local deployments.
SESSION_SECURE=false

# Comma-separated allowed origins for CORS. With docker-compose the
# browser only ever sees same-origin :8080 requests so this is unused
# at runtime; keep a sane default for safety.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Seed accounts written by app/init_db.py on every container start.
# init_db is idempotent — once a username exists its password is left
# alone, so changing these after first boot has no effect.
SEED_ADMIN_USERNAME=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_VIEWER_USERNAME=CHANGE_ME
SEED_VIEWER_PASSWORD=CHANGE_ME

# Shared JWT signing secret for the OnlyOffice Document Server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONLYOFFICE_JWT_SECRET=CHANGE_ME

# Discord OAuth (optional during the password->OAuth transition). Leave
# blank to keep Discord login disabled. Create an app at
# https://discord.com/developers/applications, add the redirect URI to its
# OAuth2 settings, and copy the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8081/api/auth/discord/callback
# Initial guild (server) ID used until an admin sets one in Settings > Discord.
# Once set in the UI, the DB value takes precedence over this default.
DISCORD_GUILD_ID=

# Login password for the sqlite-web DB browser (the sqlite-web compose service
# on host port 8119). It's a single shared password — no username — so anyone
# with it gets full read/write to the SQLite DB; use a strong value and only
# expose it on a trusted network (it's plain HTTP).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(18))"
SQLITE_WEB_PASSWORD=CHANGE_ME
