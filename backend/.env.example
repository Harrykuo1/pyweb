# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file.

# Session signing secret (required). Use a long random string.
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION
SESSION_MAX_AGE_SECONDS=86400
# Session cookie Secure flag. Leave false for local / plain-HTTP dev. Set true
# in production ONLY once the site is served over HTTPS — it makes the browser
# send the session cookie over HTTPS only. Turning it on while still on plain
# HTTP means the cookie is never sent back, so nobody can stay logged in.
SESSION_SECURE=false

DATABASE_URL=sqlite:///./pyweb.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed accounts written by init_db.py. Required: no defaults.
SEED_ADMIN_USERNAME=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_VIEWER_USERNAME=CHANGE_ME
SEED_VIEWER_PASSWORD=CHANGE_ME

# Discord OAuth (optional during the password->OAuth transition). Leave
# blank to keep Discord login disabled. Create an app at
# https://discord.com/developers/applications, add the redirect URI to its
# OAuth2 settings, and copy the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8081/api/auth/discord/callback
# Initial guild (server) ID used until an admin sets one in Settings > Discord.
# Once set in the UI, the DB value takes precedence over this default.
DISCORD_GUILD_ID=
