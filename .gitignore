# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Bind-mounted runtime data (docker-compose). Keep the directory but
# never commit the actual DB; .gitkeep retains the folder in git.
/data/*
!/data/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Claude Code local settings
.claude/

# Superpowers plan / scratch docs (tool-generated, kept local)
docs/superpowers/

# Superpowers brainstorm scratch (tool-generated HTML / server pid / state, local only)
.superpowers/

# Agent-skills artifacts (skills CLI lockfile + ui-ux-pro-max design-system output)
skills-lock.json
design-system/

# rclone — never commit; contains OAuth refresh token + (if used) crypt password
rclone.conf
.rclone.conf

# OS
.DS_Store
Thumbs.db

# Playwright MCP session artifacts (snapshots, console logs, screenshots)
.playwright-mcp/
